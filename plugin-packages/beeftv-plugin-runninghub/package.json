{
  "name": "beeftv-plugin-runninghub",
  "version": "0.1.0",
  "description": "把 RunningHub 接进 BeefTV：你的工作流和 AI 应用就是模型，画布上直接用它们生成图片、视频和音频。",
  "type": "module",
  "license": "Apache-2.0",
  "keywords": [
    "beeftv-plugin",
    "runninghub",
    "comfyui",
    "workflow",
    "image",
    "video",
    "audio"
  ],
  "beeftv": {
    "name": "RunningHub",
    "contributes": {
      "providers": [
        {
          "id": "runninghub",
          "label": "RunningHub",
          "module": "./provider.mjs",
          "capabilities": [
            "image",
            "video",
            "audio"
          ],
          "scopes": [
            "user.custom-channel",
            "canvas",
            "creation",
            "agent"
          ],
          "baseUrl": "https://www.runninghub.cn",
          "auth": {
            "type": "bearer",
            "field": "apiKey"
          }
        }
      ]
    }
  },
  "files": [
    "provider.mjs",
    "lib",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "author": "BeefTV"
}
