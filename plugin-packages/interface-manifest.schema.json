{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/wyuzhi/qisiTV/main/plugin-packages/interface-manifest.schema.json",
  "title": "qisiTV 接口插件 manifest",
  "description": "描述一个模型服务的请求格式：怎么发请求、怎么查进度、怎么取结果。完整校验以 `qisitv plugin validate` 为准，这份 schema 用于编辑器提示。",
  "type": "object",
  "required": ["apiVersion", "id", "name", "version", "contributes"],
  "properties": {
    "$schema": { "type": "string" },
    "apiVersion": { "enum": ["qisitv.plugin/v1", "qisitv.plugin/v2", "qisitv.plugin/v3", "beeftv.plugin/v1", "beeftv.plugin/v2", "beeftv.plugin/v3"], "description": "用到 variables、defaultPathPrefix 或图片流响应时要写 v3。" },
    "id": { "$ref": "#/$defs/identifier", "description": "插件 ID，小写字母、数字、- _ .，不超过 96 个字符。" },
    "name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "version": { "type": "string", "minLength": 1 },
    "author": { "type": "string", "maxLength": 120 },
    "description": { "type": "string" },
    "documentation": { "type": "string" },
    "permissions": { "type": "array", "items": { "type": "string" } },
    "configuration": {
      "type": "object",
      "properties": {
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type"],
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string" },
              "label": { "type": "string" },
              "required": { "type": "boolean" },
              "secret": { "type": "boolean" },
              "default": {}
            }
          }
        }
      }
    },
    "contributes": {
      "type": "object",
      "properties": {
        "providers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/provider" } },
        "workflows": { "type": "array", "items": { "$ref": "#/$defs/workflow" } }
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$" },
    "capability": { "enum": ["text", "image", "video", "audio"] },
    "scope": { "enum": ["admin.system-channel", "user.custom-channel", "canvas", "creation", "agent"] },
    "operation": {
      "type": "object",
      "required": ["method"],
      "properties": {
        "method": { "type": "string", "description": "GET、POST 等。" },
        "path": { "type": "string", "description": "请求路径，如 /v1/chat/completions；可用 {{model}}、{{taskId}}。" },
        "pathTemplate": {},
        "defaultPathPrefix": { "type": "string" },
        "originPath": { "type": "boolean" },
        "contentType": { "type": "string" },
        "contentTypeTemplate": {},
        "headers": { "type": "object" },
        "query": { "type": "object" },
        "body": { "description": "请求体模板，用 $ref、$coalesce、$map 等表达式取统一请求里的字段。" },
        "fields": { "type": "object" },
        "files": { "type": "array" }
      }
    },
    "provider": {
      "type": "object",
      "required": ["id", "label", "capabilities", "scopes"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier", "description": "接口 ID，模型设置里保存的就是它。" },
        "label": { "type": "string", "minLength": 1 },
        "legacyAliases": { "type": "array", "items": { "$ref": "#/$defs/identifier" }, "description": "这个接口以前用过的 ID。已保存的模型写着旧 ID 时仍会用到这里，旧命名空间下的 providerOptions 也照样生效。" },
        "presets": {
          "type": "array",
          "description": "说同一种接口的服务商。用户在「选择服务商」里一键带出名字和地址。",
          "items": {
            "type": "object",
            "required": ["id", "label", "baseUrl"],
            "properties": {
              "id": { "$ref": "#/$defs/identifier" },
              "label": { "type": "string", "minLength": 1 },
              "baseUrl": { "type": "string", "pattern": "^https?://[^\\s?#@]+$" }
            },
            "additionalProperties": false
          }
        },
        "capabilities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/capability" } },
        "scopes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scope" } },
        "baseUrl": { "type": "string", "description": "默认服务地址；用户可在连接里改。" },
        "requiresPublicMediaUrls": { "type": "boolean" },
        "mediaTransport": { "type": "object", "additionalProperties": { "type": "string" } },
        "mediaUpload": {
          "type": "object",
          "description": "服务商自带的参考素材上传接口。配置后，本地或内联参考素材会先上传到此接口换取在线 URL 再提交生成请求。",
          "properties": {
            "url": { "type": "string" },
            "path": { "type": "string" },
            "field": { "type": "string" },
            "maxBytes": { "type": "integer" },
            "urlPaths": { "type": "array", "items": { "type": "string" } },
            "errorPaths": { "type": "array", "items": { "type": "string" } },
            "successCodes": { "type": "array" },
            "messagePaths": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "auth": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "description": "bearer、header、query、basic、none，或厂商签名方式。" },
            "field": { "type": "string" },
            "secretField": { "type": "string" },
            "header": { "type": "string" },
            "prefix": { "type": "string" },
            "query": { "type": "string" },
            "username": { "type": "string" },
            "service": { "type": "string" },
            "region": { "type": "string" }
          }
        },
        "parameters": {
          "type": "array",
          "description": "写给读插件的人看的参数说明，BeefTV 不读取。",
          "items": { "$ref": "#/$defs/parameter" }
        },
        "validations": {
          "type": "array",
          "items": { "type": "object", "required": ["assert", "message"], "properties": { "assert": {}, "message": { "type": "string" } } }
        },
        "variables": { "type": "array" },
        "create": { "$ref": "#/$defs/operation" },
        "agent": { "$ref": "#/$defs/operation" },
        "poll": { "$ref": "#/$defs/operation" },
        "cancel": { "$ref": "#/$defs/operation" },
        "result": { "$ref": "#/$defs/operation" },
        "response": { "type": "object", "description": "从上游响应里取任务号、状态、文本或媒体地址。" },
        "agentResponse": { "type": "object" },
        "module": { "type": "string", "description": "插件包里实现 submit/query 的 JS 文件；写了它就不写 create 和 poll。" }
      },
      "additionalProperties": false
    },
    "parameter": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "required": { "type": "boolean" },
        "description": { "type": "string" },
        "values": { "type": "array", "items": { "type": "string" } },
        "min": { "type": "integer" },
        "max": { "type": "integer" },
        "mapping": { "type": "string" }
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "required": ["id", "label", "providerId", "capability"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "providerId": { "$ref": "#/$defs/identifier" },
        "capability": { "$ref": "#/$defs/capability" },
        "parameters": { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
        "defaults": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } }
      },
      "additionalProperties": false
    }
  }
}
